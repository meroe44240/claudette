# Copy to .env (never commit it).
CHAT_DOMAIN=chat.humanup.io
ACME_EMAIL=meroe@humanup.io
MM_VERSION=11.11.4

POSTGRES_USER=mmuser
POSTGRES_PASSWORD=change-me-long-random

# Emails (password resets, invites). Off until cutover day.
MM_SEND_EMAILS=false
MM_FROM_EMAIL=chat@humanup.io
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURITY=TLS
SMTP_USER=resend
SMTP_PASSWORD=

# Push preview: full (message text) or generic (sender and channel only).
MM_PUSH_CONTENTS=full

BACKUP_KEEP_DAYS=14
# Off-site backups with rclone, e.g. hetzner:humanup-chat-backups (needs backup/rclone.conf).
RCLONE_REMOTE=
