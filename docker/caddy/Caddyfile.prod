ats.propium.co {
  @mcp_api {
    path /mcp
    path /mcp/*
  }
  handle @mcp_api {
    reverse_proxy api:3001
  }

  handle /oauth/* {
    reverse_proxy api:3001
  }

  handle /.well-known/oauth-authorization-server {
    reverse_proxy api:3001
  }

  handle /.well-known/oauth-protected-resource {
    reverse_proxy api:3001
  }

  handle /api/* {
    reverse_proxy api:3001
  }

  # Fichiers uploades (CV, documents) servis par l'API (fastify-static)
  handle /uploads/* {
    reverse_proxy api:3001
  }

  handle {
    reverse_proxy web:80
  }
}

# Humanup Chat (Mattermost, deployed separately in /opt/humanup-chat, joined to this network)
chat.propium.co {
  encode zstd gzip

  # Agent Hub API for the agents (REST + MCP). /mm/* is only for Mattermost, inside Docker.
  handle_path /hub/* {
    @internal path /mm/*
    respond @internal 404
    reverse_proxy humanup-chat-hub:3100
  }

  handle {
    reverse_proxy humanup-chat:8065
  }
}
